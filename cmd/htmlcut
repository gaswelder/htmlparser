#!/usr/bin/php
<?php

require __DIR__ . '/../init.php';

use gaswelder\htmlparser\dom\ElementNode;
use \gaswelder\htmlparser\Parser;

function forall(ElementNode $e, callable $f)
{
    $f($e);
    foreach ($e->children() as $c) {
        forall($c, $f);
    }
}

/**
 * Keep only what matches the selector.
 */
function crop(string $selector, array $argv)
{
    foreach ($argv as $arg) {
        try {
            $doc = Parser::parse(file_get_contents($arg));
        } catch (Exception $e) {
            echo "$arg: " . $e->getMessage();
            continue;
        }
        $n = $doc->querySelector($selector);
        if ($n == NULL) {
            continue;
        }
        echo $arg, "\n";
        file_put_contents($arg, $n->innerHTML());
    }
}

/**
 * Delete everything that matches the selector.
 */
function cut(string $selector, array $argv)
{
    foreach ($argv as $arg) {
        try {
            $doc = Parser::parse(file_get_contents($arg));
        } catch (Exception $e) {
            echo "$arg: " . $e->getMessage();
            continue;
        }
        $n = 0;


        $sels = explode(',', $selector);
        foreach ($sels as $sel) {
            if ($sel[0] == '@') {
                $k = substr($sel, 1);
                foreach ($doc->children() as $c) {
                    forall($c, function ($e) use ($k, &$n) {
                        if ($e->getAttribute($k) !== null) {
                            $e->removeAttribute($k);
                            $n++;
                        }
                    });
                }
            } else {
                foreach ($doc->querySelectorAll($sel) as $e) {
                    $e->remove();
                    $n++;
                }
            }
        }

        if ($n > 0) {
            echo $arg, "\n";
            $s = $doc->format();
            file_put_contents($arg, $s);
        }
    }
}

array_shift($argv);
define('USAGE', "arguments: [-i] <selector> <filepath> ...");

$mode = null;
$selector = '';

while (count($argv) > 0 && $argv[0][0] == '-') {
    if ($argv[0] == "-h") {
        printf(USAGE . "\n");
        printf("\t-i\tinvert selection: keep matches, remove rest\n");
        exit(0);
    }
    if ($argv[0] == '-i') {
        $mode = 'i';
        array_shift($argv);
        continue;
    }
    fprintf(STDERR, "unknown flag: $argv[0]\n");
    exit(1);
}

$selector = array_shift($argv);
if (!$selector) {
    fprintf(STDERR, USAGE . "\n");
    exit(1);
}

if ($mode == 'i') {
    crop($selector, $argv);
} else {
    cut($selector, $argv);
}
